# API key. For Azure OpenAI, the existing Azure key can be reused here.
OPENAI_API_KEY=

# Deployment/model name. Example for the Azure environment used by this PoC.
OPENAI_MODEL=gpt-4.1

# When this is set, the app automatically uses Azure OpenAI Chat Completions.
# Leave it empty to use the native OpenAI Responses API instead.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Optional alternative secret name. If set, this takes precedence over OPENAI_API_KEY.
AZURE_OPENAI_API_KEY=
